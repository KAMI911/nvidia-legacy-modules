<package name="nvidia-legacy-@SERIES@" project="@OBS_PROJECT@">
  <title>NVIDIA legacy @SERIES@ driver (kernel-matched)</title>
  <description>Reproducible kernel-matched build of NVIDIA @VERSION@. Rendered + checksum-pinned by CI.</description>
  <person userid="@OBS_USER@" role="maintainer"/>

  <!-- Build wherever the _multibuild flavours resolve a .dsc; publish nowhere
       until the release gate enables a repository (obs-set-publish.py, or a
       manual `osc` once `osc results` for that repo is green). -->
  <build><enable/></build>
  <publish><disable/></publish>
</package>
