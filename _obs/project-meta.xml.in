<project name="@OBS_PROJECT@">
  <title>NVIDIA legacy drivers — kernel-matched .ko (Debian &amp; Ubuntu, reproducible)</title>
  <description>
    Prebuilt per-kernel-ABI .ko packages for legacy NVIDIA driver series
    (71/96/173/304/340/390/470/580xx). Source packages are rendered and
    checksum-pinned by CI in https://github.com/KAMI911/nvidia-legacy-modules ;
    OBS builds them in a clean chroot. Publishing is gated on the no-GPU test
    suite passing. Not affiliated with NVIDIA.
  </description>
  <person userid="@OBS_USER@" role="maintainer"/>
  <person userid="@OBS_USER@" role="bugowner"/>

  <!-- publish is OFF at project level: individual packages are published only
       after the release gate is green for that repository (see _obs/README.md). -->
  <build><enable/></build>
  <publish><disable/></publish>
  <debuginfo><disable/></debuginfo>

  <repository name="Debian_13">
    <path project="Debian:13" repository="standard"/>
    <arch>x86_64</arch>
    <arch>i586</arch>
  </repository>
  <repository name="Debian_12">
    <path project="Debian:12" repository="standard"/>
    <arch>x86_64</arch>
    <arch>i586</arch>
  </repository>
  <repository name="Debian_11">
    <path project="Debian:11" repository="standard"/>
    <arch>x86_64</arch>
    <arch>i586</arch>
  </repository>
  <repository name="xUbuntu_26.04">
    <path project="Ubuntu:26.04" repository="universe"/>
    <arch>x86_64</arch>
  </repository>
  <repository name="xUbuntu_24.04">
    <path project="Ubuntu:24.04" repository="universe"/>
    <arch>x86_64</arch>
  </repository>
  <repository name="xUbuntu_22.04">
    <path project="Ubuntu:22.04" repository="universe"/>
    <arch>x86_64</arch>
  </repository>
  <repository name="xUbuntu_20.04">
    <path project="Ubuntu:20.04" repository="universe"/>
    <arch>x86_64</arch>
  </repository>
</project>
