<services>
  <!-- FALLBACK ONLY. Default flow is CI-push via tools/obs-sync.sh (see README).
       Enable this (set mode="default") to let OBS pull from Git instead. -->
  <service name="obs_scm" mode="disabled">
    <param name="url">https://github.com/kami911/nvidia-legacy-modules.git</param>
    <param name="scm">git</param>
    <param name="revision">main</param>
    <param name="submodules">enable</param>
    <param name="subdir">packaging/@SERIES@/@TARGET@</param>
    <param name="versionformat">@PARENT_TAG@+git%cd.%h</param>
  </service>
  <service name="tar" mode="disabled"/>
  <service name="recompress" mode="disabled">
    <param name="compression">xz</param>
    <param name="file">*.tar</param>
  </service>
  <service name="set_version" mode="disabled"/>
  <service name="download_files" mode="disabled">
    <!-- .run blobs: verify-run.sh pins the hash; OBS offline build forbids this. -->
  </service>
</services>
