# Project config for home:<login>:nvidia-legacy:modules
# (no tokens — apply verbatim: osc meta prjconf <project> -F prjconf)
#
# The Debian/Ubuntu base projects already set Type/Repotype and provide the
# build chroot via OBS's normal package resolution. Do NOT force
# Buildengine: debootstrap here — pointing it at the aggregated <path> repo
# fails with "Couldn't find these debs: apt mawk".

Type: dsc
Repotype: debian

# Determinism: UTC + stable locale. SOURCE_DATE_EPOCH is set per package by
# debhelper from debian/changelog — never pin it here.
Environment: TZ "UTC"
Environment: LC_ALL "C.UTF-8"
Environment: DEB_BUILD_OPTIONS "reproducible=+all parallel=4"
