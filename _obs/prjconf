# Project config for home:<login>:nvidia-legacy:modules
# (no tokens — apply verbatim: osc meta prjconf <project> -F prjconf)
#
# All repositories are Debian/Ubuntu, so no %if guard is needed. The Debian/
# Ubuntu base projects already set Type/Repotype; we restate them for clarity
# and add the build-time helpers debootstrap's minimal set lacks.

Type: dsc
Repotype: debian
Buildengine: debootstrap
Patterntype: none

Support: ca-certificates
Support: xz-utils
Support: dpkg-dev
Support: debhelper
Support: dh-dkms
Support: quilt

# Determinism: UTC + stable locale. SOURCE_DATE_EPOCH is set per package by
# debhelper from debian/changelog — never pin it here.
Environment: TZ "UTC"
Environment: LC_ALL "C.UTF-8"
Environment: DEB_BUILD_OPTIONS "reproducible=+all parallel=4"
