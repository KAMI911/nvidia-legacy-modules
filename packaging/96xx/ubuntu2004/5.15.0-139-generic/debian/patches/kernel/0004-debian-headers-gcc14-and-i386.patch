+        # when the flavor Makefile doesn't have them (a no-op on a
+        # non-split, e.g. Ubuntu, layout where the two are the same file).
+        #
+        if [ ! -f $MAKEFILE ] || ! grep -q "^VERSION =" $MAKEFILE 2>/dev/null; then
+            if [ -f "$NV_COMMON_SOURCES/Makefile" ]; then
+                MAKEFILE="$NV_COMMON_SOURCES/Makefile"
+            fi
+        fi
 
         if [ -f $MAKEFILE ]; then
             #
@@ -1925,7 +1983,8 @@
         SELECTED_MAKEFILE=""
 
         if [ -f $HEADERS/$FILE -o -f $OUTPUT/include/$FILE -o \
-             -f $OUTPUT/include/generated/uapi/$FILE ]; then
