+                echo "#define NV_PROC_OPS_PRESENT" >> conftest.h
+                return
+            else
+                echo "#undef NV_PROC_OPS_PRESENT" >> conftest.h
+                return
+            fi
+        ;;
+
+        pde_data_lowercase)
+            #
+            # Determine if the pde_data() function (lowercase) is present.
+            # PDE_DATA() (uppercase macro/function) was itself renamed to
+            # pde_data() in later kernels; the fallback chain in this
