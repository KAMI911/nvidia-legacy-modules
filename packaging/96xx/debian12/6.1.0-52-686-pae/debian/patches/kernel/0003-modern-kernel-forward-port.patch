diff -ru a/conftest.sh b/conftest.sh
--- a/conftest.sh	2026-09-16 23:38:09.820291297 +0200
+++ b/conftest.sh	2026-09-16 23:19:53.318549023 +0200
@@ -170,6 +170,500 @@
 
 compile_test() {
     case "$1" in
+        asm_kmap_types_h)
+            #
+            # Determine if <asm/kmap_types.h> is present. It was removed
+            # when the highmem/kmap infrastructure was reworked; nothing
+            # in this driver actually uses symbols from it (it was
+            # included defensively), so this is a straight presence
+            # guard, not a functional compat shim.
+            #
+            echo "$CONFTEST_PREAMBLE
+            #include <asm/kmap_types.h>
+            " > conftest$$.c
+
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#define NV_ASM_KMAP_TYPES_H_PRESENT" >> conftest.h
+                return
+            else
+                echo "#undef NV_ASM_KMAP_TYPES_H_PRESENT" >> conftest.h
+                return
+            fi
+        ;;
+
+        arch_phys_wc_add)
+            #
+            # Determine if arch_phys_wc_add()/arch_phys_wc_del() are
+            # present with a real prototype. mtrr_add()/mtrr_del() are
+            # declared 'extern' by <asm/mtrr.h> whenever CONFIG_MTRR=y
+            # (so they compile fine), but on many distro kernels they are
+            # no longer EXPORT_SYMBOL'd for use by out-of-tree modules --
+            # a link-time failure conftest.sh's own standalone compiles
+            # cannot see. arch_phys_wc_add()/_del() are the maintained,
+            # always-exported replacement, so prefer them when present.
+            # Wrong-argument-count trick (see register_cpu_notifier
+            # above) to get a reliable answer without -Werror.
+            #
+            echo "$CONFTEST_PREAMBLE
+            #include <linux/io.h>
+            void conftest_arch_phys_wc_add(void) {
+                arch_phys_wc_add();
+            }" > conftest$$.c
+
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#undef NV_ARCH_PHYS_WC_ADD_PRESENT" >> conftest.h
+                return
+            else
+                echo "#define NV_ARCH_PHYS_WC_ADD_PRESENT" >> conftest.h
+                return
+            fi
+        ;;
+
+        asm_special_insns_h)
+            #
+            # Determine if <asm/special_insns.h> is present. read_cr4()/
+            # write_cr4() and friends moved there out of <asm/system.h>.
+            # NOTE: unlike most headers here, this one lives under
+            # arch/x86/include (not under $HEADERS or $OUTPUT/include), so
+            # a plain file-existence check against those two prefixes
+            # (as test_headers() does) would always miss it -- probe by
+            # actually compiling the #include instead.
+            #
+            echo "$CONFTEST_PREAMBLE
+            #include <linux/linkage.h>
+            #include <asm/special_insns.h>
+            " > conftest$$.c
+
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#define NV_ASM_SPECIAL_INSNS_H_PRESENT" >> conftest.h
+                return
+            else
+                echo "#undef NV_ASM_SPECIAL_INSNS_H_PRESENT" >> conftest.h
+                return
+            fi
+        ;;
+
+        asm_set_memory_h)
+            #
+            # Determine if <asm/set_memory.h> is present. set_pages_uc()
+            # and friends moved there out of <asm/cacheflush.h>. Probed
+            # by compiling the #include for the same reason as
+            # asm_special_insns_h above.
+            #
+            echo "$CONFTEST_PREAMBLE
+            #include <asm/set_memory.h>
+            " > conftest$$.c
+
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#define NV_ASM_SET_MEMORY_H_PRESENT" >> conftest.h
+                return
+            else
+                echo "#undef NV_ASM_SET_MEMORY_H_PRESENT" >> conftest.h
+                return
+            fi
+        ;;
+
+        smp_call_function_returns_int)
+            #
+            # Determine if smp_call_function() returns int (it became
+            # infallible and started returning void on later kernels).
+            # Try both the 4-arg and 3-arg forms, matching the argument-
+            # count detection done by the 'smp_call_function' test.
+            #
+            echo "$CONFTEST_PREAMBLE
+            #include <linux/smp.h>
+            void conftest_smp_call_function_returns_int(void (*func)(void *), void *info, int wait) {
+                int ret = smp_call_function(func, info, 0, wait);
+                (void)ret;
+            }" > conftest$$.c
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#define NV_SMP_CALL_FUNCTION_RETURNS_INT" >> conftest.h
+                return
+            fi
+
+            echo "$CONFTEST_PREAMBLE
+            #include <linux/smp.h>
+            void conftest_smp_call_function_returns_int(void (*func)(void *), void *info, int wait) {
+                int ret = smp_call_function(func, info, wait);
+                (void)ret;
+            }" > conftest$$.c
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#define NV_SMP_CALL_FUNCTION_RETURNS_INT" >> conftest.h
+                return
+            else
+                echo "#undef NV_SMP_CALL_FUNCTION_RETURNS_INT" >> conftest.h
+                return
+            fi
+        ;;
+
+        on_each_cpu_returns_int)
+            #
+            # Determine if on_each_cpu() returns int (it became
+            # infallible and started returning void on later kernels).
+            # Try both the 4-arg and 3-arg forms, matching the argument-
+            # count detection done by the 'on_each_cpu' test.
+            #
+            echo "$CONFTEST_PREAMBLE
+            #include <linux/smp.h>
+            void conftest_on_each_cpu_returns_int(void (*func)(void *), void *info, int wait) {
+                int ret = on_each_cpu(func, info, 0, wait);
+                (void)ret;
+            }" > conftest$$.c
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#define NV_ON_EACH_CPU_RETURNS_INT" >> conftest.h
+                return
+            fi
+
+            echo "$CONFTEST_PREAMBLE
+            #include <linux/smp.h>
+            void conftest_on_each_cpu_returns_int(void (*func)(void *), void *info, int wait) {
+                int ret = on_each_cpu(func, info, wait);
+                (void)ret;
+            }" > conftest$$.c
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#define NV_ON_EACH_CPU_RETURNS_INT" >> conftest.h
+                return
+            else
+                echo "#undef NV_ON_EACH_CPU_RETURNS_INT" >> conftest.h
+                return
+            fi
+        ;;
+
+        spin_unlock_wait)
+            #
+            # Determine if spin_unlock_wait() is present. It was removed
+            # from the kernel (no safe generic implementation existed);
+            # every in-tree caller was converted to a lock/unlock pair,
+            # which we mirror as the fallback. Same wrong-argument-count
+            # trick as register_cpu_notifier above, for the same reason
+            # (this script's conftest CFLAGS carry no -Werror, so a
+            # genuinely-absent function would otherwise compile "fine" as
+            # an implicit declaration and be misreported as present).
+            #
+            echo "$CONFTEST_PREAMBLE
+            #include <linux/spinlock.h>
+            void conftest_spin_unlock_wait(void) {
+                spin_unlock_wait();
+            }" > conftest$$.c
+
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#undef NV_SPIN_UNLOCK_WAIT_PRESENT" >> conftest.h
+                return
+            else
+                echo "#define NV_SPIN_UNLOCK_WAIT_PRESENT" >> conftest.h
+                return
+            fi
+        ;;
+
+        file_f_dentry)
+            #
+            # Determine if 'struct file' has an 'f_dentry' member. Modern
+            # kernels only have 'f_path.dentry' (f_dentry used to be a
+            # separate field, then a macro alias for f_path.dentry, and is
+            # now gone entirely).
+            #
+            echo "$CONFTEST_PREAMBLE
+            #include <linux/fs.h>
+            int conftest_file_f_dentry(void) {
+                return offsetof(struct file, f_dentry);
+            }" > conftest$$.c
+
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#define NV_FILE_HAS_F_DENTRY" >> conftest.h
+                return
+            else
+                echo "#undef NV_FILE_HAS_F_DENTRY" >> conftest.h
+                return
+            fi
+        ;;
+
+        register_cpu_notifier)
+            #
+            # Determine if register_cpu_notifier() is present. The notifier-
+            # based CPU hotplug API (register_cpu_notifier(), CPU_DOWN_PREPARE,
+            # CPU_DOWN_FAILED, etc.) was removed from the kernel when the
+            # hotplug state machine was reworked, and this conftest.sh does
+            # not add -Werror=implicit-function-declaration to its own
+            # CFLAGS -- so a straightforward "does it link" probe would
+            # wrongly report "present" for a genuinely-absent function (an
+            # implicit declaration just warns, it does not fail the
+            # compile). Instead, call with the WRONG argument count: if the
+            # function is really declared, that's a hard "too few
+            # arguments" error (unconditional in C, no -Werror needed); if
+            # it is absent, the bogus implicit-int call compiles fine.
+            #
+            echo "$CONFTEST_PREAMBLE
+            #include <linux/cpu.h>
+            int conftest_register_cpu_notifier(void) {
+                register_cpu_notifier();
+                return 0;
+            }" > conftest$$.c
+
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#undef NV_REGISTER_CPU_NOTIFIER_PRESENT" >> conftest.h
+                return
+            else
+                echo "#define NV_REGISTER_CPU_NOTIFIER_PRESENT" >> conftest.h
+                return
+            fi
+        ;;
+
+        pci_map_sg)
+            #
+            # Determine if pci_map_sg()/pci_unmap_sg() are present.
+            # <linux/pci-dma-compat.h> (which provided them as thin
+            # wrappers over dma_map_sg()/dma_unmap_sg()) was removed;
+            # dma_map_sg(&dev->dev, ...) is the direct replacement.
+            # Wrong-argument-count trick as above (no -Werror in this
+            # script's own conftest CFLAGS).
+            #
+            echo "$CONFTEST_PREAMBLE
+            #include <linux/pci.h>
+            void conftest_pci_map_sg(void) {
+                pci_map_sg();
+            }" > conftest$$.c
+
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#undef NV_PCI_MAP_SG_PRESENT" >> conftest.h
+                return
+            else
+                echo "#define NV_PCI_MAP_SG_PRESENT" >> conftest.h
+                return
+            fi
+        ;;
+
+        ioremap_nocache)
+            #
+            # Determine if ioremap_nocache() is present. It was removed
+            # once every architecture's ioremap() became non-cached by
+            # default (they were made identical, then the _nocache name
+            # was dropped) -- plain ioremap() is the correct replacement.
+            # Wrong-argument-count trick (see register_cpu_notifier
+            # above): this script's conftest CFLAGS carry no -Werror, so
+            # a genuinely-absent function would otherwise compile "fine"
+            # as an implicit declaration and be misreported as present.
+            #
+            echo "$CONFTEST_PREAMBLE
+            #include <asm/io.h>
+            void conftest_ioremap_nocache(void) {
+                ioremap_nocache();
+            }" > conftest$$.c
+
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#undef NV_IOREMAP_NOCACHE_PRESENT" >> conftest.h
+                return
+            else
+                echo "#define NV_IOREMAP_NOCACHE_PRESENT" >> conftest.h
+                return
+            fi
+        ;;
+
+        vmalloc_has_pgprot_arg)
+            #
+            # Determine if __vmalloc() still takes a pgprot_t argument.
+            # It was removed in Linux 5.8 ("mm: remove the pgprot
+            # argument to __vmalloc") -- vmalloc() is now always
+            # PAGE_KERNEL.
+            #
+            echo "$CONFTEST_PREAMBLE
+            #include <linux/vmalloc.h>
+            void conftest_vmalloc_pgprot(void) {
+                __vmalloc(0, 0, PAGE_KERNEL);
+            }" > conftest$$.c
+
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#define NV_VMALLOC_HAS_PGPROT_ARG" >> conftest.h
+                return
+            else
+                echo "#undef NV_VMALLOC_HAS_PGPROT_ARG" >> conftest.h
+                return
+            fi
+        ;;
+
+        vm_flags_set)
+            #
+            # Determine if vm_flags_set() is present. vma->vm_flags became
+            # a read-only accessor in Linux 6.3+ (direct '|=' is a compile
+            # error); vm_flags_set()/vm_flags_clear() are the replacement.
+            # Wrong-argument-count trick as above, so a genuinely-absent
+            # function (older kernels) isn't misreported as present.
+            #
+            echo "$CONFTEST_PREAMBLE
+            #include <linux/mm.h>
+            void conftest_vm_flags_set(void) {
+                vm_flags_set();
+            }" > conftest$$.c
+
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#undef NV_VM_FLAGS_SET_PRESENT" >> conftest.h
+                return
+            else
+                echo "#define NV_VM_FLAGS_SET_PRESENT" >> conftest.h
+                return
+            fi
+        ;;
+
+        i2c_del_adapter_returns_int)
+            #
+            # Determine if i2c_del_adapter() returns int (it became
+            # infallible and started returning void on later kernels).
+            #
+            echo "$CONFTEST_PREAMBLE
+            #include <linux/i2c.h>
+            void conftest_i2c_del_adapter_returns_int(struct i2c_adapter *adap) {
+                int ret = i2c_del_adapter(adap);
+                (void)ret;
+            }" > conftest$$.c
+            $CC $CFLAGS -c conftest$$.c > /dev/null 2>&1
+            rm -f conftest$$.c
+            if [ -f conftest$$.o ]; then
+                rm -f conftest$$.o
+                echo "#define NV_I2C_DEL_ADAPTER_RETURNS_INT" >> conftest.h
+                return
+            else
+                echo "#undef NV_I2C_DEL_ADAPTER_RETURNS_INT" >> conftest.h
+                return
+            fi
+        ;;
+
+        proc_create_data)
+            #
+            # Determine if proc_create_data() is present. create_proc_entry()
+            # (the old way to make a procfs file, with a directly-assignable
+            # .read_proc callback on the returned struct proc_dir_entry) was
+            # removed entirely; proc_create_data() + a proc_ops/file_operations
