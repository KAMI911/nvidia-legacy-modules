PACKAGE_NAME="nvidia-legacy-340xx"
PACKAGE_VERSION="340.108"
AUTOINSTALL="yes"

# IGNORE_PREEMPT_RT_PRESENCE=1: build on PREEMPT_RT kernels too — upstream's
# conftest otherwise bails on RT. RT is best-effort (non-blocking in CI).
# Flat legacy layout (340.108): kernel/Makefile builds a single nvidia.ko via
# the singular `module` target.
MAKE[0]="'make' -j$(nproc) IGNORE_PREEMPT_RT_PRESENCE=1 module SYSSRC=${kernel_source_dir} KERNEL_UNAME=${kernelver}"
CLEAN="'make' KERNEL_UNAME=${kernelver} clean"

BUILT_MODULE_NAME[0]="nvidia"
BUILT_MODULE_LOCATION[0]="."
DEST_MODULE_LOCATION[0]="/updates/dkms"
MAKE[0]+="; make -C uvm module SYSSRC=${kernel_source_dir} KERNEL_UNAME=${kernelver} KBUILD_EXTMOD=${dkms_tree}/nvidia-legacy-340xx/340.108/build/uvm"
CLEAN="${CLEAN}; make -C uvm KERNEL_UNAME=${kernelver} clean"
BUILT_MODULE_NAME[1]="nvidia-uvm"
BUILT_MODULE_LOCATION[1]="uvm"
DEST_MODULE_LOCATION[1]="/updates/dkms"

# Skip modules that a given kernel/arch cannot build instead of failing the
# whole DKMS build.
BUILD_EXCLUSIVE_KERNEL_MIN="3.10"
