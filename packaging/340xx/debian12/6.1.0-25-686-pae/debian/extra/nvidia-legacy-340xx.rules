# udev rules for the NVIDIA 340.108 (340xx) driver device nodes.
KERNEL=="nvidia", RUN+="/usr/bin/nvidia-modprobe -c0 -m"
KERNEL=="nvidia_modeset", RUN+="/usr/bin/nvidia-modprobe -c0 -m"
KERNEL=="nvidia_uvm", RUN+="/usr/bin/nvidia-modprobe -c0 -u"
SUBSYSTEM=="pci", ATTRS{vendor}=="0x10de", DRIVERS=="nvidia", TAG+="seat", TAG+="master-of-seat"
