+quiet_cmd_nv_core_objs_copy = CP      $@
+      cmd_nv_core_objs_copy = \
+	if [ "$(abspath $(src)/$(RESMAN_CORE_OBJS))" != "$(abspath $(obj)/$(RESMAN_CORE_OBJS))" ]; then \
