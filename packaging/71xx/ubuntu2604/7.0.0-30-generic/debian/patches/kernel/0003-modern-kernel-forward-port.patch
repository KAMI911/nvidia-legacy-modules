-	cp $(src)/$(RESMAN_CORE_OBJS) $(obj)/$(RESMAN_CORE_OBJS)
+#
+# RESMAN_CORE_OBJS (nv-kernel.o, the closed-source RM core) is not built by
+# a normal compile or if_changed rule, so newer kbuild's modpost never
+# records a .cmd file for it and hard-fails ("could not find
+# .nv-kernel.o.cmd"). Route it through if_changed (which always records
+# a .cmd regardless of what the command does) with a copy that no-ops
+# when $(src) and $(obj) are the same directory, as they are for a
+# normal out-of-tree module build -- a plain 'cp same-file same-file'
+# errors out on some cp implementations.
