+#if defined(NV_PROC_CREATE_DATA_PRESENT)
+#if defined(NV_PDE_DATA_LOWERCASE_PRESENT)
+# define NV_PDE_DATA(inode) pde_data(inode)
+#else
+# define NV_PDE_DATA(inode) PDE_DATA(inode)
+#endif
+
+/*
+ * create_proc_entry() and struct proc_dir_entry's directly-assignable
+ * .read_proc/.data/.owner/.next/.subdir fields were all removed; modern
+ * procfs needs a proc_ops (or file_operations, pre-5.6) table plus
+ * proc_create_data()/proc_mkdir(), and a seq_file "show" callback rather
+ * than a raw-buffer one. Rather than rewrite every nv_kern_read_*()
+ * function (which take the classic read_proc_t "write into this
+ * PAGE_SIZE buffer, return the length" shape and don't use start/off/
+ * count -- single-shot output, never paginated), wrap that shape in a
+ * shim: the show callback calls the original function into a fresh page
+ * and seq_write()s the result, so every read_proc_t function body stays
+ * exactly as NVIDIA wrote it.
+ */
+typedef int (*nv_read_proc_t)(char *, char **, off_t, int, int *, void *);
+
+typedef struct {
+    nv_read_proc_t read_proc;
+    void *data;
+} nv_proc_shim_t;
+
+static int nv_proc_shim_show(struct seq_file *m, void *v)
+{
+    nv_proc_shim_t *shim = m->private;
+    char *page;
+    char *start = NULL;
+    int eof = 0;
+    int len;
+
+    page = (char *)__get_free_page(GFP_KERNEL);
+    if (!page)
+        return -ENOMEM;
+
+    len = shim->read_proc(page, &start, 0, PAGE_SIZE, &eof, shim->data);
+    if (len > 0)
+        seq_write(m, start ? start : page, len);
+
+    free_page((unsigned long)page);
+    return 0;
+}
+
+static int nv_proc_shim_open(struct inode *inode, struct file *file)
+{
+    return single_open(file, nv_proc_shim_show, NV_PDE_DATA(inode));
+}
+
+#if defined(NV_PROC_OPS_PRESENT)
+static const struct proc_ops nv_proc_shim_fops = {
+    .proc_open    = nv_proc_shim_open,
+    .proc_read    = seq_read,
+    .proc_lseek   = seq_lseek,
+    .proc_release = single_release,
+};
+#else
+static const struct file_operations nv_proc_shim_fops = {
+    .owner   = THIS_MODULE,
+    .open    = nv_proc_shim_open,
+    .read    = seq_read,
+    .llseek  = seq_lseek,
+    .release = single_release,
+};
+#endif
+
+/* returns NULL on failure, like create_proc_entry() did */
+static struct proc_dir_entry *nv_create_proc_read_entry(
+    const char *name,
+    struct proc_dir_entry *parent,
+    int flags,
+    nv_read_proc_t read_proc,
+    void *data
+)
+{
+    nv_proc_shim_t *shim;
+    struct proc_dir_entry *entry;
+
+    NV_KMALLOC(shim, sizeof(nv_proc_shim_t));
+    if (!shim)
+        return NULL;
+
+    shim->read_proc = read_proc;
+    shim->data = data;
+
+    entry = proc_create_data(name, flags, parent, &nv_proc_shim_fops, shim);
+    if (!entry)
+        NV_KFREE(shim, sizeof(nv_proc_shim_t));
+
+    return entry;
+}
+#endif /* defined(NV_PROC_CREATE_DATA_PRESENT) */
