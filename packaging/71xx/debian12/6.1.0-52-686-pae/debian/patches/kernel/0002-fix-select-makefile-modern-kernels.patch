diff -ru a/Makefile.kbuild b/Makefile.kbuild
--- a/Makefile.kbuild	2026-09-16 09:35:47.917215405 +0200
+++ b/Makefile.kbuild	2026-09-16 09:35:47.919910560 +0200
@@ -134,11 +134,26 @@
 PATCHLEVEL ?= $(shell $(CONFTEST) kernel_patch_level)
 
 #
+# PATCHLEVEL alone does not reliably mean "this is Linux 2.4": kbuild
+# sets PATCHLEVEL from the target kernel's own VERSION.PATCHLEVEL.SUBLEVEL
+# scheme, and modern kernel.PATCHLEVEL numbering (5.4, 6.4, 7.4, ...)
+# coincidentally collides with the ancient 2.4.x PATCHLEVEL value --
+# wrongly routing any "x.4" kernel down the Linux-2.4-only build paths
+# below (Rules.make, .o module extension, etc). Only genuine Linux 2.4
+# (VERSION == 2) should take those paths.
+#
+ifeq ($(VERSION),2)
+ NV_IS_KERNEL_2_4 := $(if $(filter 4,$(PATCHLEVEL)),1,0)
+else
+ NV_IS_KERNEL_2_4 := 0
+endif
+
+#
 # Linux 2.4 uses the .o module extension. Linux 2.6, however, uses the .ko
 # module extension. Handle these gracefully.
 #
 
-ifeq ($(PATCHLEVEL), 4)
+ifeq ($(NV_IS_KERNEL_2_4), 1)
  MODULE_OBJECT := $(MODULE_NAME).o
 else
  MODULE_OBJECT := $(MODULE_NAME).ko
@@ -163,7 +178,7 @@
  EXTRA_CFLAGS += -DDEBUG -g 
 endif
 
-ifneq ($(PATCHLEVEL), 4)
+ifneq ($(NV_IS_KERNEL_2_4), 1)
  COMPILE_TESTS = \
 	remap_page_range \
 	remap_pfn_range \
@@ -227,7 +242,7 @@
 # More quirks for Linux 2.4 KBUILD, which doesn't link automatically.
 #
 
-ifeq ($(PATCHLEVEL), 4)
+ifeq ($(NV_IS_KERNEL_2_4), 1)
 $(obj)/$(MODULE_NAME).o: $($(MODULE_NAME)-objs)
 	$(LD) $(EXTRA_LDFLAGS) -r -o $@ $($(MODULE_NAME)-objs)
 endif
@@ -327,6 +342,6 @@
 # includes dependencies automatically.
 #
 
-ifeq ($(PATCHLEVEL), 4)
+ifeq ($(NV_IS_KERNEL_2_4), 1)
 include $(KERNEL_SOURCES)/Rules.make
 endif
