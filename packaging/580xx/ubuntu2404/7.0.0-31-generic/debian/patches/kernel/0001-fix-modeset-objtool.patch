--- a/nvidia-modeset/nvidia-modeset.Kbuild
+++ b/nvidia-modeset/nvidia-modeset.Kbuild
@@ -14,6 +14,14 @@
 obj-m += nvidia-modeset.o
 nvidia-modeset-y := $(NVIDIA_MODESET_OBJECTS)
 
+# nv-modeset-kernel.o_binary (linked in below) is a closed-source blob and
+# isn't objtool-clean for every mitigation scheme (observed: "'naked' return
+# found in MITIGATION_RETHUNK build" against Debian trixie's 6.12 kernel) --
+# same class of issue as 390xx/470xx/304xx's nv-kernel.o (see those series'
+# nvidia.Kbuild). OBJECT_FILES_NON_STANDARD is the real kernel-documented
+# mechanism (scripts/Makefile.build) for excluding objects like this.
+OBJECT_FILES_NON_STANDARD := y
+
 NVIDIA_MODESET_KO = nvidia-modeset/nvidia-modeset.ko
 
 NV_KERNEL_MODULE_TARGETS += $(NVIDIA_MODESET_KO)
