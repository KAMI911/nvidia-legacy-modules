Architecture: amd64
Depends: ${misc:Depends}, ${shlibs:Depends}
Description: NVIDIA legacy 470.256.02 driver — utilities
 nvidia-smi, nvidia-settings, nvidia-xconfig, nvidia-debugdump,
 nvidia-persistenced and the GTK backends for the 470.256.02 driver.

Package: xserver-xorg-video-nvidia-legacy-470xx
Architecture: amd64
Depends:
